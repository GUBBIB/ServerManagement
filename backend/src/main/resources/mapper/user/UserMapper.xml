<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.github.gubbib.backend.domain.user.mapper.UserMapper">

    <!-- LoginUserDTO 생성자 매핑: record 선언 순서와 일치 -->
    <resultMap id="loginUserResultMap"
               type="com.github.gubbib.backend.domain.auth.DTO.LoginUserDTO">
        <constructor>
            <idArg column="USER_ID" javaType="java.lang.Long"/>
            <arg column="EMAIL" javaType="java.lang.String"/>
            <arg column="PASSWORD" javaType="java.lang.String"/>
            <arg column="NAME" javaType="java.lang.String"/>
            <arg column="PHONE" javaType="java.lang.String"/>
            <arg column="STATUS" javaType="java.lang.String"/>

            <arg column="USER_ID"
                 javaType="java.util.List"
                 select="selectRolesByUserId"/>
        </constructor>
    </resultMap>

    <!-- 유저 역할 조회 -->
    <select id="selectRolesByUserId" parameterType="java.lang.Long" resultType="java.lang.String">
        SELECT ROLE_CODE
        FROM TB_USER_ROLE_MANAGE
        WHERE USER_ID = #{USER_ID}
          AND DELETED_AT IS NULL
        ORDER BY ROLE_CODE
    </select>

    <!-- status = [ ACTIVE, PENDING ] 인 유저 조회 --> <!-- 사용 안 하는 코드 삭제 필요 -->
    <select id="selectActiveAndPendingUserByEmail" resultMap="loginUserResultMap">
        SELECT USER_ID,
               EMAIL,
               PASSWORD,
               NAME,
               STATUS
        FROM TB_USER_MANAGE
        WHERE EMAIL = #{EMAIL}
          AND DELETED_AT IS NULL
          AND STATUS IN ('ACTIVE', 'PENDING')
    </select>

    <!-- 유저 존재 여부 조회 - 이메일  -->
    <select id="existsByEmail" resultType="java.lang.Boolean">
        SELECT EXISTS(SELECT 1
                      FROM TB_USER_MANAGE
                      WHERE EMAIL = #{EMAIL})
    </select>

    <!-- 유저 조회 - EMAIL -->
    <select id="selectUserByEmail" resultMap="loginUserResultMap">
        SELECT USER_ID,
               EMAIL,
               PASSWORD,
               NAME,
               PHONE,
               STATUS
        FROM TB_USER_MANAGE
        WHERE EMAIL = #{EMAIL}
    </select>

    <!-- 유저 조회 - USER_ID -->
    <select id="selectUserByUserId" resultMap="loginUserResultMap">
        SELECT USER_ID,
               EMAIL,
               PASSWORD,
               NAME,
               PHONE,
               STATUS
        FROM TB_USER_MANAGE
        WHERE USER_ID = #{USER_ID}
    </select>

    <update id="changePassword">
        UPDATE TB_USER_MANAGE
        SET PASSWORD   = #{ENCODED_PASSWORD},
            UPDATED_AT = NOW()

        WHERE USER_ID = #{USER_DETAILS.id}
          AND DELETED_AT IS NULL
    </update>

</mapper>
